# ==============================================================================
# Operations Dashboard — Environment Variables Template (.env.example)
# Duplicate this file to .env.local and fill in your credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# Core Application Configuration (Required)
# ------------------------------------------------------------------------------
APP_URL=http://localhost:3000
NODE_ENV=development

# ------------------------------------------------------------------------------
# Supabase Database (Required)
# Retrieve from: Supabase Dashboard -> Project Settings -> API
# Note: Requires SUPABASE_SERVICE_ROLE_KEY because this application uses custom
# server-side cookie authentication and accesses PostgreSQL directly.
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------------------------------------------------------------------------------
# Authentication & JWT Session Security (Required)
# JWT_SECRET must be at least 32 characters long.
# ------------------------------------------------------------------------------
JWT_SECRET=your-32-plus-characters-random-secret-key-here
JWT_ISSUER=operations-dashboard
JWT_AUDIENCE=operations-dashboard-web
SESSION_TTL_HOURS=8
INVITATION_TTL_HOURS=72
PASSWORD_RESET_TTL_MINUTES=60

# ------------------------------------------------------------------------------
# Admin Bootstrap Configuration (Used by: npm run admin:bootstrap)
# ------------------------------------------------------------------------------
ADMIN_BOOTSTRAP_EMAIL=admin_email
ADMIN_BOOTSTRAP_PASSWORD=password
ADMIN_BOOTSTRAP_NAME=Operations Administrator

# ------------------------------------------------------------------------------
# Google Sheets Integration (Optional - for operational data synchronization)
# ------------------------------------------------------------------------------
# GOOGLE_SHEETS_SPREADSHEET_ID=your-google-sheets-spreadsheet-id
# Subsheet / tab name to sync (e.g. "Above 50k Orders"):
# GOOGLE_SHEETS_WORKSHEET="Above 50k Orders"
# Multiple subsheets (comma-separated):
# GOOGLE_SHEETS_WORKSHEETS="Above 50k Orders,Subsheet 2"
# GOOGLE_SERVICE_ACCOUNT_EMAIL=service-account@your-project.iam.gserviceaccount.com
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ------------------------------------------------------------------------------
# SMTP Email Dispatch (Optional - for invitations and password resets)
# ------------------------------------------------------------------------------
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@example.com
# SMTP_PASSWORD=your-app-password
# EMAIL_FROM="Operations Dashboard <no-reply@example.com>"

# ------------------------------------------------------------------------------
# Upstash Redis (Optional - for distributed rate limiting)
# If omitted, the application falls back gracefully to in-memory / Postgres.
# ------------------------------------------------------------------------------
# UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-token
RATE_LIMIT_FAIL_CLOSED=false

# ------------------------------------------------------------------------------
# Cache & Polling Configuration
# ------------------------------------------------------------------------------
DATA_CACHE_TTL_SECONDS=120
AUTO_REFRESH_INTERVAL_SECONDS=120

# ------------------------------------------------------------------------------
# Scheduled Cron Endpoints & Error Monitoring (Optional)
# ------------------------------------------------------------------------------
CRON_SECRET=your-random-cron-secret-at-least-16-chars
# ERROR_WEBHOOK_URL=https://webhook.site/your-webhook-id

