{
  "name": "operations-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build",
    "admin:bootstrap": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/bootstrap-admin.ts",
    "sheets:inspect": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/inspect-sheet.ts",
    "smtp:verify": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/verify-smtp.ts"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource/dm-serif-display": "^5.3.0",
    "@supabase/supabase-js": "^2.118.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.6",
    "framer-motion": "^14.7.1",
    "google-auth-library": "^11.3.2",
    "jose": "^6.2.14",
    "lenis": "^1.3.27",
    "lucide-react": "^1.64.0",
    "next": "16.4.3",
    "nodemailer": "^10.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.13",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
